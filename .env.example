# Copy to .env.local and fill in. Everything here is optional — the site builds and
# runs with none of it set. What each one turns on is noted below.

# ── Site ──────────────────────────────────────────────────────────────────────
# The real production origin. Feeds canonical URLs, the sitemap and Open Graph.
# Wrong or unset in production means canonicals point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://driftedmarketing.com


# ── Contact form delivery (handoff gap 5) ─────────────────────────────────────
# Set at least one transport, or the form tells visitors it isn't connected and
# points them at the email address. Both may be set: email is tried first, the
# webhook is the fallback.

# Transport 1 — email via Resend. Both are required together.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@driftedmarketing.com
# Must be on a domain verified in Resend. Defaults to briefs@driftedmarketing.com.
CONTACT_FROM_EMAIL=briefs@driftedmarketing.com

# Transport 2 — POST the brief as JSON anywhere (CRM, Zapier, a queue).
CONTACT_FORM_ENDPOINT=
# Optional bearer token sent with the webhook.
CONTACT_FORM_TOKEN=


# ── Spam protection ───────────────────────────────────────────────────────────
# Cloudflare Turnstile. Cookie-free, unlike reCAPTCHA. Set BOTH to turn it on:
# the widget renders client-side and the server rejects a missing token. With
# neither set the form still has a honeypot and per-IP rate limiting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ── Analytics (handoff gap 6) ─────────────────────────────────────────────────
# Cookie-free by requirement of the brief. Pick ONE — setting both means Plausible
# wins, because running two is double-counting rather than redundancy.

# Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only needed if self-hosting. Defaults to https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_HOST=

# Umami
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Only needed if self-hosting. Defaults to https://cloud.umami.is
NEXT_PUBLIC_UMAMI_HOST=
